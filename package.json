{
  "name": "sohokari",
  "version": "0.1.0",
  "private": true,
  "description": "Sohokari (সহকারী) - Bangla-First Zero-LLM AI Assistant for Bangladesh Citizen Services",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build:client": "esbuild src/client/main.ts --bundle --minify --outfile=public/app.js && esbuild src/client/styles/app.css --minify --outfile=public/app.css",
    "build": "npm run build:client && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0",
    "wrangler": "^3.86.0"
  }
}
