# =====================================================================
# SOHOKARI (সহকারী) - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# 1. GitHub Configuration
GITHUB_REPO=
GITHUB_PAT=your_github_personal_access_token
GITHUB_USERNAME=your_username
GITHUB_EMAIL=your_email@example.com

# 2. Cloudflare D1, R2 & Vectorize Configuration
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_R2_BUCKET_NAME=sohokari-assets
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_VECTORIZE_INDEX=sohokari-citizen-services

# 3. Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 4. Zyte API Configuration
ZYTE_API_KEY=your_zyte_api_key
ZYTE_USE_PROXY=true

# 5. Cloud Runners Configuration
DEEPNOTE_API_KEY=your_deepnote_api_key
CAMBERCLOUD_API_KEY=your_camber_api_key

# 6. Scraping Engine & Politeness Settings
SCRAPER_CONCURRENCY=5
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_USER_AGENT=SohokariCitizenBot/1.0 (+https://github.com/abumdselim/sohokari)
CONTINUOUS_CYCLE_INTERVAL_MINUTES=360
REQUEST_TIMEOUT_SECONDS=45
MAX_RETRIES=3

# 7. Local Storage & Cache
LOCAL_DATA_DIR=./data
LOCAL_LOGS_DIR=./logs
